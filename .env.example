# Firebase Web App config — Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vazio em dev: frontend usa URLs relativas (proxy do Vite).
# Preencher com URL de producao no build (CI/CD). Ex: https://api-xxxx.a.run.app
VITE_API_URL=

# URL da API para o proxy do Vite (dev). Ex: ngrok, http://localhost:8080
API_PROXY_TARGET=

# URL do frontend (SPA). Usada nos links dos e-mails transacionais.
# Ex.: https://achiropita-100.web.app
APP_URL=

# Disparo transacional de comunicados por e-mail (Brevo). Ficam no .env da API.
# Remetente deve estar verificado em Brevo > Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# E-mails de teste do botao "Teste" do comunicado: parametro emails-teste
# (criado na pagina Parâmetros; JSON array ou texto separado por virgula).
# Padrao em codigo quando o parametro nao existe: pgennari@gmail.com.

# Notificacao por e-mail ao cadastrar bloqueio pendente aprovacao. Params
# criados na pagina Parâmetros (parametros.acessar):
# - bloqueio.notificar-aprovadores: "true" dispara para todos os usuarios com a
#   permissao pessoas.bloqueio (exceto o solicitante); "false" dispara para o
#   e-mail de teste abaixo.
# - bloqueio.email-teste: e-mail de teste usado quando notificar-aprovadores
#   esta "false". Ex.: teste.bloqueio@gmail.com
