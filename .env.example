# Configure no console do Firebase: Project settings → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Quando =1, o cliente conecta nos emuladores locais (auth/firestore/functions/storage)
NEXT_PUBLIC_USE_EMULATORS=0

# Domínio base usado para gerar links públicos de validação (US-06-05)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apenas para scripts/admin (não vai pro bundle do client)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=
