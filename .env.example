# Firebase Web App config — Project settings → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vazio em dev: frontend usa URLs relativas (proxy do Vite).
# Preencher com URL de producao no build (CI/CD). Ex: https://api-xxxx.a.run.app
VITE_API_URL=

# URL da API para o proxy do Vite (dev). Ex: ngrok, http://localhost:8080
API_PROXY_TARGET=
