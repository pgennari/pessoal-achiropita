rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function ehAnon() {
      return autenticado()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function temPerfilDoc() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function ehAdmOuOrg() {
      return temPerfilDoc() && perfil() in ["ADM", "ORG"];
    }

    function podeOperarEntregas() {
      return temPerfilDoc() && perfil() in ["ADM", "ORG", "OPC"];
    }

    function ehAdm() {
      return temPerfilDoc() && perfil() == "ADM";
    }

    // ---------- Helpers de validacao publica (US-06-06) ----------

    function temSessaoValidacao() {
      return ehAnon()
        && exists(/databases/$(database)/documents/sessoesValidacao/$(request.auth.uid));
    }

    function dadosSessao() {
      return get(/databases/$(database)/documents/sessoesValidacao/$(request.auth.uid)).data;
    }

    function sessaoVigente() {
      return temSessaoValidacao()
        && dadosSessao().expiraEm > request.time;
    }

    function linkDaSessaoAtivo() {
      return exists(/databases/$(database)/documents/linksValidacao/$(dadosSessao().token))
        && get(/databases/$(database)/documents/linksValidacao/$(dadosSessao().token)).data.status == "ativo"
        && get(/databases/$(database)/documents/linksValidacao/$(dadosSessao().token)).data.expiraEm > request.time;
    }

    function pessoaIdDaSessao() {
      return dadosSessao().pessoaId;
    }

    // Sessao anon (validacao publica) atualiza todos os dados pessoais
    // exceto crachá (identificador estável), flag de ativacao e foto.
    function diffPessoaSemSensiveis(novo, velho) {
      return novo.cracha == velho.cracha
        && novo.ativo == velho.ativo
        && novo.fotoUrl == velho.fotoUrl;
    }

    // Cracha e CPF so podem ser alterados pelo ADM (US-02-02 criterio).
    function preservaSensiveis(novo, velho) {
      return novo.cracha == velho.cracha && novo.cpf == velho.cpf;
    }

    function pessoaIdDoUsuario() {
      return temPerfilDoc()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.pessoaId
        : null;
    }

    // ---------- Validacoes de schema ----------

    function pessoaValida(d) {
      return d.keys().hasAll(["nome", "nascimento", "telefone", "cracha", "ativo"])
        && d.cracha is int
        && d.cracha > 0
        && d.nome is string
        && d.nascimento is string;
    }

    function edicaoValida(d) {
      return d.keys().hasAll(["numero", "ano", "inicio", "fim", "status"])
        && d.numero is int
        && d.ano is int
        && d.status in ["planejamento", "ativa", "encerrada"];
    }

    function barracaValida(d) {
      return d.keys().hasAll([
          "edicaoId", "nome", "setor",
          "vagasCoordenador", "vagasEquipista", "vagasApoio"
        ])
        && d.nome is string
        && d.setor in ["Interna", "Externa", "Alimentacao"]
        && d.vagasCoordenador is int && d.vagasCoordenador >= 0
        && d.vagasEquipista is int && d.vagasEquipista >= 0
        && d.vagasApoio is int && d.vagasApoio >= 0;
    }

    function participacaoValida(d) {
      return d.keys().hasAll(["edicaoId", "barracaId", "pessoaId", "funcao"])
        && d.funcao in ["Coordenador", "Equipista", "Apoio"];
    }

    function entregaValida(d) {
      return d.keys().hasAll([
          "edicaoId", "pessoaId", "operadorUid", "operadorNome", "entregueEm"
        ])
        && d.edicaoId is string
        && d.pessoaId is string
        && d.operadorUid == request.auth.uid;
    }

    function turmaValida(d) {
      return d.keys().hasAll([
          "edicaoId", "data", "horarioInicio", "local", "capacidadeMaxima"
        ])
        && d.edicaoId is string
        && d.data is string
        && d.horarioInicio is string
        && d.local is string
        && d.capacidadeMaxima is int && d.capacidadeMaxima > 0;
    }

    function formacaoShape(d) {
      return d.keys().hasAll([
          "edicaoId", "pessoaId", "presencaTipo",
          "registradoPorUid", "registradoPorNome", "presencaEm",
          "dadosValidados"
        ])
        && d.presencaTipo in ["manual", "validacao"];
    }

    // Para create: alem do shape, exige que o autor seja quem escreve.
    function formacaoValida(d) {
      return formacaoShape(d) && d.registradoPorUid == request.auth.uid;
    }

    function usuarioValido(d) {
      return d.keys().hasAll(["email", "nome", "perfil"])
        && d.email is string
        && d.nome is string
        && d.perfil in ["ADM", "ORG", "CRD", "EQP", "OPC", "REC"];
    }

    function linkValidacaoValido(d) {
      return d.keys().hasAll([
          "edicaoId", "turmaId", "expiraEm", "status",
          "contadorUsos", "criadoPorUid", "criadoPorNome"
        ])
        && d.status in ["ativo", "revogado", "usado"]
        && d.contadorUsos is int && d.contadorUsos >= 0
        && d.expiraEm is timestamp;
    }

    function buscaCrachaValida(d) {
      return d.keys().hasAll(["pessoaId", "anoNascimento"])
        && d.pessoaId is string
        && d.anoNascimento is string
        && d.anoNascimento.size() == 4;
    }

    function conviteValido(d) {
      return d.keys().hasAll([
          "email", "nome", "perfil", "status",
          "criadoPorUid", "criadoPorNome"
        ])
        && d.email is string
        && d.nome is string
        && d.perfil in ["ADM", "ORG", "CRD", "EQP", "OPC", "REC"]
        && d.status in ["pendente", "usado", "revogado"];
    }

    // E-mail do auth normalizado, usado pra resolver a chave de
    // /convites quando o convidado faz o primeiro login.
    function chaveConviteDoAuth() {
      return string(request.auth.token.email).lower();
    }

    function temConvitePendenteParaPerfil(perfilEsperado) {
      return exists(/databases/$(database)/documents/convites/$(chaveConviteDoAuth()))
        && get(/databases/$(database)/documents/convites/$(chaveConviteDoAuth())).data.status == "pendente"
        && get(/databases/$(database)/documents/convites/$(chaveConviteDoAuth())).data.perfil == perfilEsperado;
    }

    // ---------- Coleções ----------

    match /usuarios/{uid} {
      // Self pode ler o proprio doc mesmo antes dele existir — caso
      // contrario o auto-provisionamento no primeiro login trava
      // (catch-22: precisamos checar se o doc existe pra criar, mas a
      // rule de read antiga exigia que ja existisse).
      allow read: if autenticado()
        && (request.auth.uid == uid || ehAdm());
      // Self-create no primeiro sign-in. Anon nao se aplica.
      // Dois ramos:
      //   1) sem convite: cria com perfil EQP (default).
      //   2) com convite pendente para o e-mail autenticado: aceita
      //      qualquer perfil contanto que bata com o convite.
      allow create: if autenticado()
        && !ehAnon()
        && request.auth.uid == uid
        && usuarioValido(request.resource.data)
        && (
          request.resource.data.perfil == "EQP"
          || temConvitePendenteParaPerfil(request.resource.data.perfil)
        );
      allow create, update: if ehAdm() && usuarioValido(request.resource.data);
      allow delete: if ehAdm();
    }

    match /convites/{email} {
      // ADM vê tudo. O proprio convidado vê seu doc (necessario para
      // consultarConvitePendente apos o login).
      allow read: if ehAdm()
        || (autenticado() && string(request.auth.token.email).lower() == email);

      // ADM cria, atualiza e revoga.
      allow create, update: if ehAdm() && conviteValido(request.resource.data);

      // Convidado consome o proprio convite: vira "pendente" → "usado"
      // mexendo apenas em status/usadoEm/usadoPorUid.
      allow update: if autenticado()
        && string(request.auth.token.email).lower() == email
        && resource.data.status == "pendente"
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "usadoEm", "usadoPorUid"])
        && request.resource.data.status == "usado"
        && request.resource.data.usadoPorUid == request.auth.uid;

      allow delete: if ehAdm();
    }

    match /pessoas/{id} {
      // Equipe normal le qualquer pessoa; sessao anon le apenas a propria.
      allow read: if temPerfilDoc()
        || (sessaoVigente() && pessoaIdDaSessao() == id);

      allow create: if ehAdmOuOrg() && pessoaValida(request.resource.data);
      // Update por:
      //   ADM: qualquer campo.
      //   ORG: tudo menos cracha/cpf (sensiveis).
      //   EQP self (usuario.pessoaId == id): tudo menos sensiveis.
      //   Sessao anon publica: campos nao sensiveis amplos.
      allow update: if pessoaValida(request.resource.data) && (
          ehAdm()
          || (ehAdmOuOrg() && preservaSensiveis(request.resource.data, resource.data))
          || (temPerfilDoc()
              && pessoaIdDoUsuario() == id
              && preservaSensiveis(request.resource.data, resource.data))
          || (sessaoVigente()
              && pessoaIdDaSessao() == id
              && linkDaSessaoAtivo()
              && diffPessoaSemSensiveis(request.resource.data, resource.data))
        );
      allow delete: if false;
    }

    match /edicoes/{id} {
      allow read: if temPerfilDoc();
      allow create: if ehAdmOuOrg() && edicaoValida(request.resource.data);
      allow update: if ehAdmOuOrg() && edicaoValida(request.resource.data);
      allow delete: if false;
    }

    match /barracas/{id} {
      allow read: if temPerfilDoc();
      allow create: if ehAdmOuOrg() && barracaValida(request.resource.data);
      allow update: if ehAdmOuOrg() && barracaValida(request.resource.data);
      allow delete: if ehAdmOuOrg();
    }

    match /participacoes/{id} {
      allow read: if temPerfilDoc();
      allow create: if ehAdmOuOrg() && participacaoValida(request.resource.data);
      allow update: if ehAdmOuOrg() && participacaoValida(request.resource.data);
      allow delete: if ehAdmOuOrg();
    }

    match /entregasCracha/{id} {
      allow read: if temPerfilDoc();
      allow create: if podeOperarEntregas() && entregaValida(request.resource.data);
      allow update: if false;
      allow delete: if ehAdm();
    }

    match /turmasFormacao/{id} {
      allow read: if temPerfilDoc();
      allow create, update: if ehAdmOuOrg() && turmaValida(request.resource.data);
      allow delete: if ehAdmOuOrg();
    }

    match /formacoes/{id} {
      // Equipe normal le qualquer formacao; sessao anon le apenas a
      // sua propria (precisa para o salvarValidacao decidir entre
      // create e update). Quando o doc nao existe, resource e null
      // — o short-circuit cobre esse caso.
      allow read: if temPerfilDoc()
        || (sessaoVigente()
            && (resource == null
                || resource.data.pessoaId == pessoaIdDaSessao()));
      allow create: if (ehAdmOuOrg() && formacaoValida(request.resource.data))
        || (sessaoVigente()
            && pessoaIdDaSessao() == request.resource.data.pessoaId
            && linkDaSessaoAtivo()
            && formacaoValida(request.resource.data)
            && request.resource.data.presencaTipo == "validacao"
            && request.resource.data.dadosValidados == true);
      allow update: if (ehAdmOuOrg() && formacaoShape(request.resource.data))
        || (sessaoVigente()
            && pessoaIdDaSessao() == resource.data.pessoaId
            && linkDaSessaoAtivo()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["dadosValidados", "validadoEm", "presencaTipo", "turmaId"])
            && request.resource.data.dadosValidados == true);
      allow delete: if ehAdmOuOrg();
    }

    match /linksValidacao/{token} {
      // Leitura publica: o id do doc E o secret. Quem tem o token, ja tem
      // o link em si — nao expomos pessoaId fora dessa relacao.
      allow read: if true;
      allow create: if ehAdmOuOrg() && linkValidacaoValido(request.resource.data);
      // ADM/ORG mexem em status (revogar), prazo etc. Sessao anon
      // incrementa apenas contadorUsos.
      allow update: if (ehAdmOuOrg() && linkValidacaoValido(request.resource.data))
        || (sessaoVigente()
            && dadosSessao().token == token
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["contadorUsos"]));
      allow delete: if ehAdm();
    }

    match /buscaCracha/{cracha} {
      // Lookup publica para a etapa de identificacao do anon. So
      // expoe pessoaId + anoNascimento; nao expoe nome ou outros
      // dados sensiveis.
      allow read: if temPerfilDoc() || sessaoVigente();
      allow create, update: if (ehAdmOuOrg() && buscaCrachaValida(request.resource.data))
        || (temPerfilDoc()
            && pessoaIdDoUsuario() == request.resource.data.pessoaId
            && buscaCrachaValida(request.resource.data))
        // Sessao anon ressincroniza apos atualizar a propria pessoa
        // (caso o ano de nascimento tenha mudado pela validacao publica).
        || (sessaoVigente()
            && pessoaIdDaSessao() == request.resource.data.pessoaId
            && linkDaSessaoAtivo()
            && buscaCrachaValida(request.resource.data));
      allow delete: if ehAdmOuOrg();
    }

    match /sessoesValidacao/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      // Fase 1: cria sessao "vazia" amarrada ao link/turma. Sem
      // pessoaId ainda — anon ainda nao se identificou.
      allow create: if ehAnon()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/linksValidacao/$(request.resource.data.token))
        && get(/databases/$(database)/documents/linksValidacao/$(request.resource.data.token)).data.status == "ativo"
        && get(/databases/$(database)/documents/linksValidacao/$(request.resource.data.token)).data.expiraEm > request.time
        && get(/databases/$(database)/documents/linksValidacao/$(request.resource.data.token)).data.turmaId == request.resource.data.turmaId
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.time
        && !request.resource.data.keys().hasAny(["pessoaId"]);
      // Fase 2: vincula pessoaId apos cliente conferir o ano via
      // /buscaCracha. So pode acrescentar pessoaId/cracha/ano; nao
      // muda token/turmaId/expiraEm. O cracha precisa bater com o
      // pessoaId via lookup em /buscaCracha (cross-doc).
      allow update: if ehAnon()
        && request.auth.uid == uid
        && resource.data.token == request.resource.data.token
        && resource.data.turmaId == request.resource.data.turmaId
        && resource.data.expiraEm == request.resource.data.expiraEm
        && !resource.data.keys().hasAny(["pessoaId"])
        && request.resource.data.pessoaId is string
        && request.resource.data.cracha is int
        && exists(/databases/$(database)/documents/buscaCracha/$(string(request.resource.data.cracha)))
        && get(/databases/$(database)/documents/buscaCracha/$(string(request.resource.data.cracha))).data.pessoaId == request.resource.data.pessoaId
        && get(/databases/$(database)/documents/buscaCracha/$(string(request.resource.data.cracha))).data.anoNascimento == request.resource.data.ano;
      allow delete: if false;
    }

    match /auditoria/{id} {
      allow read: if ehAdmOuOrg();
      allow create: if temPerfilDoc()
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.keys().hasAll(["acao", "alvo", "autor", "autorNome", "criadoEm"]);
      allow update, delete: if false;
    }
  }
}
