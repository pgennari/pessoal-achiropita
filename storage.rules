rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function ehAdmOuOrg() {
      return autenticado() && perfil() in ["ADM", "ORG"];
    }

    function ehAnon() {
      return autenticado()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function sessaoFotoValida(pessoaId) {
      return ehAnon()
        && firestore.exists(/databases/(default)/documents/sessoesFoto/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/sessoesFoto/$(request.auth.uid)).data.pessoaId == pessoaId
        && firestore.get(/databases/(default)/documents/sessoesFoto/$(request.auth.uid)).data.expiraEm > request.time;
    }

    // Foto da pessoa: catálogo legível a autenticados; ADM/ORG ou sessão de foto anon escrevem.
    // Limites: até 4 MB (após redimensionar no cliente fica < 200 KB).
    match /pessoas/{pessoaId}/foto.jpg {
      allow read: if autenticado();
      allow write: if (ehAdmOuOrg()
            || sessaoFotoValida(pessoaId))
          && request.resource.size < 4 * 1024 * 1024
          && request.resource.contentType.matches("image/.*");
      allow delete: if ehAdmOuOrg();
    }
  }
}
